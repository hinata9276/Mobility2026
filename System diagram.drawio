        <mxCell id="yNx2ymjOP0dLx5fCTiyI-45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Global memory is allocated so that it can be written by only one task but&amp;nbsp;read by multiple tasks.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If a memory region must be written by multiple tasks, a mutex must be implemented to ensure safe memory writes.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;All local memory is contained in the task itself.&amp;nbsp;&lt;/div&gt;" vertex="1">
