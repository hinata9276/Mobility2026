        <mxCell id="3ir5b1DzUsAsr0aYdjnw-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Playback Mario tone during startup, and never run again" vertex="1">
